# FDR Management Portal - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local environment.
# Never commit the actual .env file with secrets into version control.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
HOST=127.0.0.1
PORT=5000

# JWT Authentication Settings (Phase 4)
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fdr_management
DB_USER=root
DB_PASSWORD=your_secure_database_password_here

# Document Upload & OCR Configuration (Phase 5)
DOCUMENTS_UPLOAD_FOLDER=uploads/documents
MAX_DOCUMENT_SIZE=10485760
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Maturity Tracking & Alerts Configuration (Phase 6 - Optional)
# In-portal notification alerts are enabled by default in the database.
# External SMTP email dispatch is disabled by default to avoid unintentional outbound mail.
MAIL_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=noreply-fdr@aicte-india.org
